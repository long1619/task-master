# ============================================================
#  TEMPLATE BIẾN MÔI TRƯỜNG - DÙNG CHO DEPLOY DOCKER TRÊN VPS
#  Cách dùng: copy file này thành ".env" rồi điền giá trị THẬT
#             KHÔNG bao giờ commit file ".env" thật lên Git
# ============================================================

PORT=5000
NODE_ENV=production

# --- Database (MySQL chạy trong container tên "db", xem docker-compose.yml) ---
DB_NAME=taskmaster_db
# DOCKER_DB_ROOT_PASSWORD: mật khẩu root của MySQL container (chỉ container dùng nội bộ)
# DOCKER_DB_USER/DOCKER_DB_PASSWORD: tài khoản riêng cho ứng dụng (KHÔNG được đặt DOCKER_DB_USER=root
# vì image MySQL chính thức cấm dùng MYSQL_USER=root)
DOCKER_DB_ROOT_PASSWORD=doi_mat_khau_root_that_manh_va_ngau_nhien
DOCKER_DB_USER=taskmaster_user
DOCKER_DB_PASSWORD=doi_mat_khau_user_that_manh_va_ngau_nhien
# Lưu ý: docker-compose.yml tự ghép DATABASE_URL = mysql://DOCKER_DB_USER:DOCKER_DB_PASSWORD@db:3306/DB_NAME
# Không cần khai báo DATABASE_URL tay ở đây khi chạy bằng Docker.

# --- Bảo mật JSON Web Token (JWT) ---
# Sinh chuỗi ngẫu nhiên mạnh, ví dụ: openssl rand -base64 48
JWT_SECRET=doi_thanh_chuoi_bi_mat_ngau_nhien_it_nhat_32_ky_tu
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Gửi Email (Nodemailer) - để trống SMTP_USER/PASS nếu dùng Ethereal test ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TaskMaster Pro <no-reply@yourdomain.com>"

# --- Cron Job nhắc việc (mặc định 8:00 sáng mỗi ngày) ---
REMINDER_CRON_SCHEDULE=0 8 * * *

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
