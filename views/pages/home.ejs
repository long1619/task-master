  <div class="app-wrapper">
    <!-- Header / Navbar -->
    <header class="navbar">
      <div class="nav-left">
        <div class="logo-box">
          <i class="fa-solid fa-check"></i>
        </div>
        <div class="brand-info">
          <h1 class="brand-name">TaskMaster <span class="brand-badge-pro">PRO</span></h1>
        </div>
      </div>

      <div class="nav-right">
        <!-- Nút AI Tạo việc bằng giọng nói (Gemini AI) -->
        <button class="btn btn-ai-create" id="aiCreateTaskBtn" title="Nói tiếng Việt để AI tự động tạo công việc cho bạn">
          <i class="fa-solid fa-microphone"></i>
          <span>AI tạo việc</span>
        </button>

        <!-- Nút Báo cáo & Năng suất (Analytics & Excel/PDF) -->
        <button class="btn btn-glass" id="openAnalyticsBtn" title="Xem thống kê năng suất và xuất báo cáo Excel/PDF">
          <i class="fa-solid fa-chart-line" style="color: var(--brand-primary);"></i>
          <span>Báo cáo</span>
        </button>

        <!-- Nút Nhập dữ liệu Excel/CSV (Bulk Import) -->
        <button class="btn btn-glass" id="openImportBtn" title="Nhập hàng loạt công việc từ file Excel hoặc CSV">
          <i class="fa-solid fa-file-excel" style="color: #10b981;"></i>
          <span>Nhập Excel</span>
        </button>

        <!-- Nút Thùng rác (Soft Delete & Undo) -->
        <button class="btn btn-glass" id="openTrashBtn" title="Xem danh sách công việc đã xóa & Khôi phục">
          <i class="fa-solid fa-trash-can" style="color: #ef4444;"></i>
          <span>Thùng rác</span>
          <span class="badge-count-pill" id="trashCountBadge">0</span>
        </button>

        <!-- Nút Chuyển Giao diện Tối / Sáng (Dark / Light Mode) -->
        <button class="btn btn-glass" id="themeToggleBtn" title="Chuyển đổi Chế độ Tối / Sáng (Dark / Light Mode)">
          <i class="fa-solid fa-moon" id="themeIcon" style="color: #f59e0b;"></i>
          <span id="themeBtnText">Tối</span>
        </button>

        <!-- Nút Bảng Quản trị Admin (Role: Admin) -->
        <button class="btn btn-glass btn-admin-nav" id="openAdminBtn" style="display: none;" title="Bảng quản trị hệ thống (Admin Dashboard)">
          <i class="fa-solid fa-shield-halved" style="color: #f59e0b;"></i>
          <span>Quản trị</span>
        </button>

        <!-- Auth Navigation Status -->
        <div class="auth-nav-container">
          <!-- View khi chưa đăng nhập -->
          <div id="authGuestView">
            <button class="btn btn-primary" id="openAuthModalBtn">
              <i class="fa-solid fa-arrow-right-to-bracket"></i>
              <span>Đăng nhập</span>
            </button>
          </div>

          <!-- View khi đã đăng nhập -->
          <div id="authUserView" style="display: none;">
            <div class="user-pill">
              <div class="user-avatar" id="navUserAvatar">U</div>
              <div class="user-details">
                <span class="user-name" id="navUserName">Người dùng</span>
                <span class="user-role-badge" id="navUserRole">user</span>
              </div>
              <button class="btn-logout" id="logoutBtn" title="Đăng xuất">
                <i class="fa-solid fa-right-from-bracket"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Overview Stats Metric Grid -->
    <section class="hero-stats">
      <div class="stat-card stat-total">
        <div class="stat-info">
          <span class="stat-title">Toàn bộ công việc</span>
          <h2 class="stat-number" id="totalTasksCount">0</h2>
        </div>
        <div class="stat-icon-wrapper"><i class="fa-solid fa-layer-group"></i></div>
      </div>

      <div class="stat-card stat-pending">
        <div class="stat-info">
          <span class="stat-title">Chờ thực hiện</span>
          <h2 class="stat-number" id="pendingTasksCount">0</h2>
        </div>
        <div class="stat-icon-wrapper"><i class="fa-regular fa-clock"></i></div>
      </div>

      <div class="stat-card stat-progress">
        <div class="stat-info">
          <span class="stat-title">Đang xử lý</span>
          <h2 class="stat-number" id="inProgressTasksCount">0</h2>
        </div>
        <div class="stat-icon-wrapper"><i class="fa-solid fa-arrows-rotate"></i></div>
      </div>

      <div class="stat-card stat-completed">
        <div class="stat-info">
          <span class="stat-title">Đã hoàn thành</span>
          <h2 class="stat-number" id="completedTasksCount">0</h2>
        </div>
        <div class="stat-icon-wrapper"><i class="fa-solid fa-circle-check"></i></div>
      </div>
    </section>

    <!-- Slim Progress Bar -->
    <div class="progress-section">
      <div class="progress-label">
        <i class="fa-solid fa-chart-pie" style="color: var(--brand-primary);"></i>
        <span>Tiến độ hoàn thành:</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" id="progressFill" style="width: 0%"></div>
      </div>
      <div class="progress-value" id="completionPercentage">0%</div>
    </div>

    <!-- Main Workspace (2 Columns) -->
    <main class="main-layout">
      <!-- Left Column: Form Thêm Công Việc Mới -->
      <aside class="sidebar-form">
        <div class="card-white form-card">
          <div class="card-header">
            <div class="header-icon"><i class="fa-solid fa-plus"></i></div>
            <div>
              <h3 class="card-title">Thêm công việc mới</h3>
              <p class="card-subtitle">Điền thông tin và tạo việc nhanh</p>
            </div>
          </div>

          <form id="createTaskForm" class="styled-form">
            <!-- Tiêu đề -->
            <div class="form-field">
              <label for="taskTitle">Tiêu đề công việc <span class="accent">*</span></label>
              <div class="input-wrapper">
                <i class="fa-solid fa-pen-nib field-icon"></i>
                <input
                  type="text"
                  id="taskTitle"
                  name="title"
                  placeholder="Ví dụ: Thiết kế giao diện sáng cho ứng dụng..."
                  required
                  minlength="3"
                  autocomplete="off"
                >
                <button type="button" class="btn-field-voice btn-field-voice-title" id="voiceTitleBtn" title="Nói để AI tự động tạo công việc">
                  <i class="fa-solid fa-microphone"></i>
                </button>
              </div>
              <div class="field-hint">
                <span>Tối thiểu 3 ký tự</span>
                <span id="charCounter">0/100</span>
              </div>
            </div>

            <!-- Mô tả -->
            <div class="form-field">
              <label for="taskDescription">Chi tiết nội dung</label>
              <div class="input-wrapper">
                <textarea
                  id="taskDescription"
                  name="description"
                  rows="3"
                  placeholder="Ghi chú chi tiết nội dung công việc..."
                ></textarea>
              </div>
            </div>

            <!-- 2 Cột: Trạng thái & Mức độ ưu tiên -->
            <div class="form-row-2">
              <div class="form-field">
                <label for="taskStatus">Trạng thái</label>
                <div class="select-wrapper">
                  <select id="taskStatus" name="status">
                    <option value="pending">⏳ Chờ làm</option>
                    <option value="in_progress">🚀 Đang làm</option>
                    <option value="completed">✅ Đã xong</option>
                  </select>
                  <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
              </div>

              <div class="form-field">
                <label for="taskPriority">Mức độ ưu tiên</label>
                <div class="select-wrapper">
                  <select id="taskPriority" name="priority">
                    <option value="low">🟢 Thấp (Low)</option>
                    <option value="medium" selected>🟡 Vừa (Medium)</option>
                    <option value="high">🔴 Cao (High)</option>
                  </select>
                  <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
              </div>
            </div>

            <!-- Hạn chót hoàn thành -->
            <div class="form-field">
              <label for="taskDueDate">Hạn chót hoàn thành</label>
              <div class="input-wrapper">
                <i class="fa-regular fa-calendar field-icon"></i>
                <input type="datetime-local" id="taskDueDate" name="dueDate">
              </div>
            </div>

            <!-- Phân công Dự án & Giao việc (Tùy chọn) -->
            <div class="form-row-2">
              <div class="form-field">
                <label for="createTaskWorkspace">Dự án</label>
                <div class="select-wrapper">
                  <select id="createTaskWorkspace" name="workspaceId">
                    <option value="">(Cá nhân)</option>
                  </select>
                  <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
              </div>

              <div class="form-field">
                <label for="createTaskAssignee">Giao cho</label>
                <div class="select-wrapper">
                  <select id="createTaskAssignee" name="assigneeId">
                    <option value="">(Chính mình)</option>
                  </select>
                  <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
              </div>
            </div>

            <div class="create-actions-group">
              <button type="submit" class="btn btn-primary" id="submitCreateBtn">
                Tạo việc ngay
              </button>
            </div>
          </form>
        </div>
      </aside>

      <!-- Right Column: Danh Sách Công Việc & Bộ Lọc -->
      <section class="task-feed">
        <div class="card-white feed-card">
          <!-- Toolbar Bộ Lọc & Sắp Xếp Trực Quan -->
          <div class="feed-toolbar-advanced">
            <!-- Ô Tìm kiếm & View Switcher -->
            <div class="search-and-view-row">
              <div class="search-input-box">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="searchInput" placeholder="Tìm kiếm nhanh theo tiêu đề hoặc nội dung..." autocomplete="off">
                <button type="button" class="btn-clear-search" id="clearSearchBtn" style="display: none;" title="Xóa tìm kiếm">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>

              <!-- View Mode Switcher: Danh sách vs Bảng Kanban vs Lịch biểu -->
              <div class="view-mode-toggle" id="viewModeToggle">
                <button type="button" class="view-toggle-btn active" id="viewListBtn" data-view="list" title="Xem dạng danh sách công việc">
                  <i class="fa-solid fa-list-ul"></i>
                  <span>Danh sách</span>
                </button>
                <button type="button" class="view-toggle-btn" id="viewKanbanBtn" data-view="kanban" title="Xem dạng Bảng Kanban kéo thả">
                  <i class="fa-solid fa-table-columns"></i>
                  <span>Bảng Kanban</span>
                </button>
                <button type="button" class="view-toggle-btn" id="viewCalendarBtn" data-view="calendar" title="Xem dạng Lịch biểu theo tháng">
                  <i class="fa-solid fa-calendar-days"></i>
                  <span>Lịch biểu</span>
                </button>
              </div>
            </div>

            <!-- Hàng điều khiển bộ lọc & sắp xếp -->
            <div class="toolbar-controls-row">
              <!-- Bộ lọc Trạng thái (Segmented Tabs) -->
              <div class="filter-pills" id="statusFilterPills">
                <button class="pill-btn active" data-status="all">
                  <span>Tất cả</span>
                  <span class="pill-counter" id="badgeAll">0</span>
                </button>
                <button class="pill-btn" data-status="pending">
                  <span class="dot dot-amber"></span>
                  <span>Chờ làm</span>
                  <span class="pill-counter" id="badgePending">0</span>
                </button>
                <button class="pill-btn" data-status="in_progress">
                  <span class="dot dot-cyan"></span>
                  <span>Đang làm</span>
                  <span class="pill-counter" id="badgeInProgress">0</span>
                </button>
                <button class="pill-btn" data-status="completed">
                  <span class="dot dot-emerald"></span>
                  <span>Đã xong</span>
                  <span class="pill-counter" id="badgeCompleted">0</span>
                </button>
              </div>

              <!-- Lọc theo Mức ưu tiên (Priority) -->
              <div class="select-wrapper select-compact">
                <select id="filterPrioritySelect" title="Lọc theo mức độ ưu tiên">
                  <option value="all">⚡ Tất cả mức ưu tiên</option>
                  <option value="high">🔴 Ưu tiên Cao</option>
                  <option value="medium">🟡 Ưu tiên Vừa</option>
                  <option value="low">🟢 Ưu tiên Thấp</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
              </div>

              <!-- Sắp xếp danh sách (Sort By) -->
              <div class="select-wrapper select-compact">
                <select id="sortBySelect" title="Sắp xếp danh sách">
                  <option value="createdAt:desc">⏰ Mới tạo nhất</option>
                  <option value="createdAt:asc">⏳ Cũ nhất</option>
                  <option value="dueDate:asc">📅 Hạn chót: Gần nhất</option>
                  <option value="dueDate:desc">📅 Hạn chót: Xa nhất</option>
                  <option value="priority:desc">🔴 Ưu tiên cao trước</option>
                </select>
                <i class="fa-solid fa-arrow-down-wide-short select-arrow"></i>
              </div>
            </div>
          </div>

          <!-- Thanh Chọn hàng loạt (Bulk Selection Header) -->
          <div class="list-selection-bar" id="listSelectionBar">
            <label class="select-all-label">
              <input type="checkbox" id="selectAllCheckbox" class="custom-checkbox">
              <span>Chọn tất cả trên trang này</span>
            </label>
            <span class="selection-counter" id="selectionCounterText">0 mục đã chọn</span>
          </div>

          <!-- Danh Sách Các Task Items -->
          <div class="task-stream" id="tasksContainer"></div>

          <!-- Thanh phân trang động -->
          <div class="pagination-bar" id="paginationBar" style="display: none;">
            <div class="pagination-info">
              Hiển thị <strong id="pagStart">0</strong> - <strong id="pagEnd">0</strong> trên tổng số <strong id="pagTotal">0</strong> công việc
            </div>

            <div class="pagination-controls" id="paginationControls"></div>

            <div class="pagination-limit-box">
              <label for="limitSelect">Hiển thị:</label>
              <select id="limitSelect">
                <option value="5">5 / trang</option>
                <option value="10" selected>10 / trang</option>
                <option value="20">20 / trang</option>
              </select>
            </div>
          </div>

          <!-- Bảng Kanban Kéo Thả (Drag & Drop Kanban Board) -->
          <div class="kanban-board-wrapper" id="kanbanBoardWrapper" style="display: none;">
            <div class="kanban-columns-grid">
              <!-- Cột 1: Chờ làm (Pending) -->
              <div class="kanban-column" data-status="pending">
                <div class="kanban-column-header header-amber">
                  <div class="col-title-group">
                    <span class="col-dot dot-amber"></span>
                    <span class="col-title">Chờ thực hiện</span>
                  </div>
                  <span class="col-badge" id="kanbanPendingBadge">0</span>
                </div>
                <div class="kanban-dropzone" id="kanbanPendingZone" data-status="pending"></div>
              </div>

              <!-- Cột 2: Đang làm (In Progress) -->
              <div class="kanban-column" data-status="in_progress">
                <div class="kanban-column-header header-cyan">
                  <div class="col-title-group">
                    <span class="col-dot dot-cyan"></span>
                    <span class="col-title">Đang xử lý</span>
                  </div>
                  <span class="col-badge" id="kanbanInProgressBadge">0</span>
                </div>
                <div class="kanban-dropzone" id="kanbanInProgressZone" data-status="in_progress"></div>
              </div>

              <!-- Cột 3: Đã xong (Completed) -->
              <div class="kanban-column" data-status="completed">
                <div class="kanban-column-header header-emerald">
                  <div class="col-title-group">
                    <span class="col-dot dot-emerald"></span>
                    <span class="col-title">Đã hoàn thành</span>
                  </div>
                  <span class="col-badge" id="kanbanCompletedBadge">0</span>
                </div>
                <div class="kanban-dropzone" id="kanbanCompletedZone" data-status="completed"></div>
              </div>
            </div>
          </div>

          <!-- Chế độ Xem Lịch Biểu (Calendar View / Timeline) -->
          <div class="calendar-view-wrapper" id="calendarViewWrapper" style="display: none;">
            <div class="calendar-header-bar">
              <div class="calendar-nav">
                <button type="button" class="btn btn-glass btn-icon" id="calPrevMonthBtn" title="Tháng trước">
                  <i class="fa-solid fa-chevron-left"></i>
                </button>
                <h3 class="calendar-month-title" id="calendarMonthTitle">Tháng 9, 2026</h3>
                <button type="button" class="btn btn-glass btn-icon" id="calNextMonthBtn" title="Tháng sau">
                  <i class="fa-solid fa-chevron-right"></i>
                </button>
                <button type="button" class="btn btn-glass btn-sm" id="calTodayBtn">Hôm nay</button>
              </div>
              <div class="calendar-legend-bar">
                <span class="legend-badge"><span class="legend-dot dot-red"></span> Ưu tiên Cao</span>
                <span class="legend-badge"><span class="legend-dot dot-yellow"></span> Ưu tiên Vừa</span>
                <span class="legend-badge"><span class="legend-dot dot-green"></span> Ưu tiên Thấp</span>
              </div>
            </div>

            <!-- Header các thứ trong tuần -->
            <div class="calendar-weekdays-grid">
              <div>Thứ Hai</div>
              <div>Thứ Ba</div>
              <div>Thứ Tư</div>
              <div>Thứ Năm</div>
              <div>Thứ Sáu</div>
              <div>Thứ Bảy</div>
              <div class="sunday-col">Chủ Nhật</div>
            </div>

            <!-- Lưới các ngày trong tháng -->
            <div class="calendar-month-grid" id="calendarDaysGrid"></div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal Chỉnh Sửa Công Việc (Edit Task) -->
  <div class="modal-backdrop" id="editModalOverlay">
    <div class="modal-box edit-modal-large">
      <div class="modal-top">
        <div class="modal-title-group">
          <div class="modal-icon"><i class="fa-solid fa-pen-to-square"></i></div>
          <div>
            <h3>Cập nhật công việc</h3>
            <p>Chỉnh sửa thông tin chi tiết và lưu trực tiếp</p>
          </div>
        </div>
        <button type="button" class="modal-close-btn" id="closeEditModalBtn">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Tabs Chuyển đổi trong Modal Sửa -->
      <div class="modal-tabs-header">
        <button type="button" class="modal-tab-btn active" id="tabBtnEditDetails" onclick="switchEditModalTab('details')">
          <i class="fa-solid fa-list-check"></i> <span>Chi tiết & Việc con</span>
        </button>
        <button type="button" class="modal-tab-btn" id="tabBtnEditComments" onclick="switchEditModalTab('comments')">
          <i class="fa-regular fa-comments"></i> <span>Bình luận</span>
          <span class="tab-badge-pill" id="editCommentsCountBadge">0</span>
        </button>
        <button type="button" class="modal-tab-btn" id="tabBtnEditAudit" onclick="switchEditModalTab('audit')">
          <i class="fa-solid fa-clock-rotate-left"></i> <span>Nhật ký hoạt động</span>
        </button>
      </div>

      <!-- Tab 1: Chi tiết & Việc con -->
      <div class="modal-tab-content active" id="editTabDetailsPane">
        <form id="editTaskForm" class="modal-form">
          <input type="hidden" id="editTaskId">
          
          <div class="form-field">
            <label for="editTaskTitle">Tiêu đề công việc <span class="accent">*</span></label>
            <div class="input-wrapper">
              <input type="text" id="editTaskTitle" required minlength="3">
            </div>
          </div>

          <div class="form-field">
            <label for="editTaskDescription">Nội dung chi tiết</label>
            <div class="input-wrapper">
              <textarea id="editTaskDescription" rows="4"></textarea>
            </div>
          </div>

          <!-- Phân công Dự án & Người thực hiện -->
          <div class="form-row-2">
            <div class="form-field">
              <label for="editTaskWorkspace"><i class="fa-solid fa-folder"></i> Dự án / Không gian</label>
              <div class="select-wrapper">
                <select id="editTaskWorkspace">
                  <option value="">(Cá nhân / Không thuộc dự án)</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
              </div>
            </div>

            <div class="form-field">
              <label for="editTaskAssignee"><i class="fa-solid fa-user-check"></i> Người thực hiện (Assignee)</label>
              <div class="select-wrapper">
                <select id="editTaskAssignee">
                  <option value="">(Chưa phân công)</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
              </div>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-field">
              <label for="editTaskStatus">Trạng thái</label>
              <div class="select-wrapper">
                <select id="editTaskStatus">
                  <option value="pending">⏳ Chờ thực hiện</option>
                  <option value="in_progress">🚀 Đang xử lý</option>
                  <option value="completed">✅ Đã hoàn thành</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
              </div>
            </div>

            <div class="form-field">
              <label for="editTaskPriority">Mức độ ưu tiên</label>
              <div class="select-wrapper">
                <select id="editTaskPriority">
                  <option value="low">🟢 Thấp (Low)</option>
                  <option value="medium">🟡 Vừa (Medium)</option>
                  <option value="high">🔴 Cao (High)</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
              </div>
            </div>
          </div>

          <div class="form-field">
            <label for="editTaskDueDate">Hạn chót hoàn thành</label>
            <div class="input-wrapper">
              <i class="fa-regular fa-calendar field-icon"></i>
              <input type="datetime-local" id="editTaskDueDate">
            </div>
          </div>

          <!-- Danh sách tệp hiện có trong modal edit -->
          <div class="form-field" id="editAttachmentsSection" style="display: none;">
            <label>Tệp đính kèm hiện tại:</label>
            <div class="attachments-compact-list" id="editAttachmentsList"></div>
          </div>

          <!-- Danh sách việc con (Checklist / Subtasks - Next-Level AI) -->
          <div class="form-field subtasks-section" id="editSubtasksSection">
            <div class="subtasks-header-row">
              <div class="subtasks-title-wrap">
                <label><i class="fa-solid fa-list-check"></i> Việc con (Checklist)</label>
